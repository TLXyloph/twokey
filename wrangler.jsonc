{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twokey",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // The ledger's event store. Append-only tables; schema in config/d1/migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twokey",
      "database_id": "fc5a2bb3-3e03-4d29-8740-f1df6a034553",
      "migrations_dir": "config/d1/migrations"
    }
  ],
  // Non-secret settings only. Secrets are set with `wrangler secret put`, never here.
  // /api/ai/turn (src/agents/llm/turn-config.ts) needs the secret TWOKEY_SESSION_SECRET, or it
  // answers 503. Without the secret ANTHROPIC_API_KEY it serves recorded "replay" answers only.
  // Its limits live in D1 (migration 0002) and are read from these vars; none has a code default:
  // - TWOKEY_AI_BUDGET_USD: the hard total for live AI calls, across all sessions. A turn first
  //   reserves its worst case (about $0.87 for the smallest turn, more for large ones), so a
  //   budget below that admits no live turn at all.
  // - TWOKEY_AI_SESSION_BUDGET_USD: each judge session's share of the total.
  // - TWOKEY_AI_SESSION_TURNS_PER_MINUTE: turns (live or replayed) per session per minute. 60, not
  //   20: one replayed multi-agent starter streams about 15 turns in seconds (measured 2026-11-03),
  //   and live spend is already bounded by the session share, since each live turn reserves ~$0.93.
  // - TWOKEY_AI_SESSIONS_PER_IP_PER_HOUR: new judge sessions per client IP (cf-connecting-ip,
  //   stored only as an HMAC) per rolling hour.
  // - TWOKEY_SITE_ORIGIN: the only Origin the AI routes accept (localhost only under `next dev`).
  "vars": {
    "TWOKEY_AI_BUDGET_USD": "10",
    "TWOKEY_AI_SESSION_BUDGET_USD": "3",
    "TWOKEY_AI_SESSION_TURNS_PER_MINUTE": "60",
    "TWOKEY_AI_SESSIONS_PER_IP_PER_HOUR": "5",
    "TWOKEY_SITE_ORIGIN": "https://twokey.afterscroll.workers.dev"
  }
}
