# PayPal SANDBOX test-account logins for TwoKey's automated tests. Sandbox only: no real money.
#
# How to use:
#   1. Copy this file to config/.env.sandbox-accounts (that name is gitignored by the ".env.*" rule).
#   2. Fill in the passwords there, never in this example file.
#   3. Never commit the real file, and never paste a password into chat.
#
# Where to find each password:
#   https://developer.paypal.com/dashboard/accounts -> the account's "..." menu -> View/Edit account
#
# Why this isn't in .env: Next.js loads .env into builds, which can bake values into the deployed app.
# It doesn't load files in config/, so these logins can't reach the hosted site.

# Parent (Dana Whitfield): logs in as the buyer to approve PayPal and Venmo checkouts in tests.
SANDBOX_PARENT_EMAIL=sb-vcau653695983@personal.example.com
SANDBOX_PARENT_PASSWORD=

# Club business account: the one the API app uses (balance about $4,998.75 on 2026-11-03).
# Makes the outside website sends for the webhook test and the judge-mode advance send.
SANDBOX_BUSINESS_EMAIL=
SANDBOX_BUSINESS_PASSWORD=
