# TwoKey: the settings `next dev` reads from .env (copy this file to .env and fill it in).
# Never commit .env. On Cloudflare, set the secrets with `wrangler secret put` (values on stdin)
# and the non-secret values as `vars` in wrangler.jsonc.

# PayPal REST app (sandbox only: any other base URL is refused)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal returns when you register the webhook (scripts/paypal-sandbox-spike.py webhook-register)
PAYPAL_WEBHOOK_ID=

# The AI (Anthropic API). Without it the AI features serve recorded answers, labelled "replay".
ANTHROPIC_API_KEY=
# Optional: the model id (default claude-opus-5-5)
# TWOKEY_AI_MODEL=

# AG Studio (the board). A trial licence works.
AG_STUDIO_LICENSE_KEY=

# The judge-session cookie's signing secret: 32+ random characters (openssl rand -base64 48)
TWOKEY_SESSION_SECRET=
# The site's own origin (POSTs from anywhere else are refused)
TWOKEY_SITE_ORIGIN=http://localhost:3000
# The public demo's AI limits
TWOKEY_AI_BUDGET_USD=10
TWOKEY_AI_SESSION_BUDGET_USD=3
TWOKEY_AI_SESSION_TURNS_PER_MINUTE=60
TWOKEY_AI_SESSIONS_PER_IP_PER_HOUR=50

# The officers' demo signing keys (Ed25519, PKCS8, base64): made by scripts/gen-demo-keys.sh
TWOKEY_DEMO_KEY_PRESIDENT=
TWOKEY_DEMO_KEY_TREASURER=
TWOKEY_DEMO_KEY_SECRETARY=
# The Reviewer's key signs the monthly close only (scripts/gen-reviewer-key.sh).
TWOKEY_DEMO_KEY_REVIEWER=

# The Watchtower's cron calls /api/watchtower/run with this bearer secret (openssl rand -base64 48)
TWOKEY_CRON_SECRET=

# Optional: the PayPal sandbox buyer login shown on the parent pay page
TWOKEY_TEST_BUYER_EMAIL=
TWOKEY_TEST_BUYER_PASSWORD=
